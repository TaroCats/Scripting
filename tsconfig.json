{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "esnext"
    ],
    "jsx": "preserve",
    "module": "commonjs",
    "declaration": false,
    "outDir": "./dist",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "scripting": [
        "dts/scripting.d.ts"
      ],
      "*": [
        "*",
        "src/*",
        "scripts/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./dts"
    ]
  },
  "include": [
    "./dts/*.d.ts",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "./dts/scripting.d.ts"
  ]
}